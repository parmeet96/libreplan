package org.libreplan.business.util;

import org.apache.commons.lang3.StringEscapeUtils;
import org.apache.commons.logging.Log;
import org.apache.commons.logging.LogFactory;

import java.lang.reflect.Field;
import java.util.Collection;

public class UserInputSanitizerUtil {
    private static final Log LOG = LogFactory.getLog(UserInputSanitizerUtil.class);

    public static void sanitizeObject(Object obj) {
        if (obj == null) return;

        Class<?> clazz = obj.getClass();

        // Traverse the class hierarchy to handle inherited fields
        while (clazz != null) {
            for (Field field : clazz.getDeclaredFields()) {
                field.setAccessible(true);
                try {
                    Object value = field.get(obj);

                    // Sanitize String fields
                    if (value instanceof String) {
                        String sanitized = StringEscapeUtils.escapeHtml4((String) value);
                        field.set(obj, sanitized);
                    }
                    // Sanitize Collections
                    else if (value instanceof Collection<?>) {
                        for (Object item : (Collection<?>) value) {
                            sanitizeObject(item);
                        }
                    }

                } catch (IllegalAccessException e) {
                    LOG.warn("error while sanitiizng user input");
                }
            }
            clazz = clazz.getSuperclass(); // Check parent classes too
        }
    }
}
